---
import FigureMod from "./FigureMod.astro";
---

<div class="two-col">
  <FigureMod
    src="figures/splitmap.svg"
    alt="Schematic longitude cut at P33 equals 4.2 degrees east. Target Iberian-Atlantic west of the cut, n = 8910. Source East and Central Europe east of the cut, n = 18090. P25 and P50 shown as unlabeled percentile guides."
    caption="Figure-module: longitude-cut construction. Source (E/Central, n = 18,090) versus target (Iberian–Atlantic, n = 8,910) at P33 = 4.2°E. P25 and P50 are percentile guides; degree values for those guides are not in the frozen table."
  />
  <p class="legend">
    <span class="split-glyph">source</span>
    E/Central Europe (n = 18,090)
    <span class="split-glyph">target</span>
    Iberian–Atlantic Europe (n = 8,910)
  </p>
</div>
